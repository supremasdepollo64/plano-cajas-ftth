{
  "name": "CTO Finder",
  "short_name": "CTO Finder",
  "description": "Localiza la caja CTO/FTTH más cercana a una ubicación.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#071b2a",
  "theme_color": "#071b2a",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
